#include <iostream>
using namespace std;

class Student {
public:
    string name;
    int rollNo;

    void display() {
        cout << "Student Name: " << name << endl;
        cout << "Roll Number: " << rollNo << endl;
    }
};

int main() {
    Student s;
    
    s.name = "Rahul";
    s.rollNo = 101;

    s.display();

    return 0;
}
