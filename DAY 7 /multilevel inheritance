#include <iostream>
using namespace std;

// Base class
class Grandparent {
public:
    void showGrandparent() {
        cout << "This is Grandparent class" << endl;
    }
};

// Derived class from Grandparent
class Parent : public Grandparent {
public:
    void showParent() {
        cout << "This is Parent class" << endl;
    }
};

// Derived class from Parent
class Child : public Parent {
public:
    void showChild() {
        cout << "This is Child class" << endl;
    }
};

int main() {
    Child obj;

    // Accessing all inherited functions
    obj.showGrandparent();
    obj.showParent();
    obj.showChild();

    return 0;
}
